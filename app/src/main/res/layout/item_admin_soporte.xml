<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAdminSoporteTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Solicitud #12"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAdminSoporteNegocio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Negocio #5"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAdminSoporteEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solicitado"
                android:textColor="#B45309"
                app:chipBackgroundColor="#FEF3C7"
                app:chipMinHeight="28dp"
                style="@style/Widget.MaterialComponents.Chip.Action" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvAdminSoporteMotivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Motivo: Asistencia en inventario"
            android:textColor="#334155"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#F1F5F9" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdminAutorizarSoporte"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Autorizar Acceso por Jerarquía"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            android:textColor="@color/sky"
            app:strokeColor="#BFDBFE" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
